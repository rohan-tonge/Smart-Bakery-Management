# ==================================================
# Smart Bakery Management System - Environment Config
# ==================================================

# Server Configuration
NODE_ENV=development
PORT=5000
ORDER_RESERVATION_MINUTES=15
# Set to the number of trusted reverse-proxy hops only when deployed behind them.
TRUST_PROXY_HOPS=0
LOG_LEVEL=debug

# Database Configuration
MONGO_URI=mongodb://127.0.0.1:27017/smart_bakery_db
MONGO_DB_NAME=smart_bakery_db

# CORS & Client
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Authentication & JWT Secrets
ACCESS_TOKEN_SECRET=replace_with_a_unique_random_secret_at_least_32_characters
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace_with_a_different_unique_random_secret_at_least_32_characters
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_a_third_unique_random_secret_at_least_32_characters
# Set COOKIE_SAME_SITE to 'none' when frontend and backend are hosted on different domains (e.g., Vercel + Render)
# Defaults to 'none' in production and 'lax' in development
COOKIE_SAME_SITE=lax

# Cloud Storage (Optional / Phase 3+)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment Gateway - Razorpay (Optional / Phase 7)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
RAZORPAY_API_BASE_URL=https://api.razorpay.com

# Email / SMTP Configuration (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@smartbakery.com
